      "source": [
        "# Crypto Engineering\n",
        "## Chapter 9 – Governance, Risk, and Compliance Memos\n",
        "\n",
        "&copy; Dr. Yves J. Hilpisch | The Python Quants GmbH<br>\n",
        "The Crypto Engineer | AI-Powered by GPT 5.1.\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "This helper reads a small change description and template, then writes a Markdown risk memo file under `governance/memos/`. It turns the chapter’s memo pattern into a concrete generator you can adapt for your own governance workflows."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "trusted": true
      },
      "outputs": [],
      "source": [
        "import json\n",
        "import pathlib\n",
        "from datetime import date\n",
        "\n",
        "base = pathlib.Path(\"governance\")\n",
        "base.mkdir(exist_ok=True)\n",
        "memo_dir = base / \"memos\"\n",
        "memo_dir.mkdir(exist_ok=True)\n",
        "\n",
        "template_path = base / \"risk_template.json\"\n",
        "change_path = base / \"pending_change.json\"\n",
        "\n",
        "if not template_path.exists():\n",
        "    template_path.write_text(json.dumps({\"regulatory_questions\": \"List key regulatory considerations here.\"}), encoding=\"utf-8\")\n",
        "if not change_path.exists():\n",
        "    change_path.write_text(\n",
        "        json.dumps(\n",
        "            {\n",
        "                \"id\": \"chg-wallet-limits\",\n",
        "                \"title\": \"Adjust withdrawal limits\",\n",
        "                \"owner\": \"alice\",\n",
        "                \"summary\": \"Increase daily withdrawal cap for verified users.\",\n",
        "                \"user_impact\": \"Higher limits for KYC-complete accounts.\",\n",
        "                \"controls\": \"Monitor large outflows; alert on anomalies.\",\n",
        "                \"open_questions\": \"Do we need updated terms of service?\",\n+        "            }\n",
        "        ),\n",
        "        encoding=\"utf-8\",\n",
        "    )\n",
        "\n",
        "template = json.loads(template_path.read_text(encoding=\"utf-8\"))\n",
        "change = json.loads(change_path.read_text(encoding=\"utf-8\"))\n",
        "\n",
        "memo = f\"\"\"# Risk Memo: {change['title']}\n",
        "Date: {date.today().isoformat()}\n",
        "Owner: {change['owner']}\n",
        "\n",
        "## Summary\n",
        "{change['summary']}\n",
        "\n",
        "## User Impact\n",
        "{change['user_impact']}\n",
        "\n",
        "## Regulatory Considerations\n",
        "{template['regulatory_questions']}\n",
        "\n",
        "## Controls and Monitoring\n",
        "{change['controls']}\n",
        "\n",
        "## Open Questions\n",
        "{change['open_questions']}\n",
        "\"\"\"\n",
        "\n",
        "path = memo_dir / f\"{change['id']}.md\"\n",
        "path.write_text(memo, encoding=\"utf-8\")\n",
        "print(f\"Wrote memo to {path}\")\n"
      ]
    },
